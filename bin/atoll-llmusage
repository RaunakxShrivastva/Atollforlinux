#!/usr/bin/env python3
# Atoll for Linux - LLM usage collector (Usage tab backend).
#
# A Quickshell/QML view cannot stream tens of megabytes of JSONL and price it,
# so the scanning lives here and the result is handed to LLMUsageService.qml as
# one JSON document on stdout. This is the Linux port of Atoll's
# managers/LLMUsage: JSONLUsageParser, ModelPricingManager and the quota
# clients, restricted to the providers whose data sources exist off macOS.
#
# Providers:
#   claude  ~/.claude/projects/**/*.jsonl  (Claude Code logs) + plan label
#   codex   $CODEX_HOME/sessions or ~/.codex/sessions  (Codex rollouts) + the
#           rate-limit windows Codex itself records in each token_count record
# Cursor, Antigravity and New API need macOS Keychain credentials, the macOS
# Antigravity app-support tree, or a user-configured endpoint; they are reported
# as a failure card with a reason, exactly like Atoll does when a provider is
# detected-but-unconfigured.
import json
import os
import re
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
PRICING = HERE / "llm-pricing.json"

SESSION_WINDOW = 5 * 3600
WEEK_WINDOW = 7 * 86400


# ---------------------------------------------------------------- pricing ----

class Pricing:
    def __init__(self, path=PRICING):
        self.rows = {}
        try:
            data = json.loads(Path(path).read_text())
        except Exception:
            data = {}
        for m in data.get("models", []):
            self.rows[m.get("id", "").lower()] = m.get("pricing", {})

    @staticmethod
    def _rate(raw):
        try:
            v = float(raw)
        except (TypeError, ValueError):
            return None
        return v if v >= 0 else None

    def rates(self, model_id):
        """Mirror of ModelPricingManager.getPricing: try cosmetic variants, and
        accept a row only when both prompt and completion rates are positive."""
        for key in self._candidates(model_id):
            row = self.rows.get(key)
            if row is None:
                continue
            prompt = self._rate(row.get("prompt"))
            completion = self._rate(row.get("completion"))
            if prompt is None or completion is None or prompt <= 0 or completion <= 0:
                continue
            return {
                "prompt": prompt,
                "completion": completion,
                "cacheRead": self._rate(row.get("cache_read")),
                "cacheWrite": self._rate(row.get("cache_write")),
            }
        return None

    @staticmethod
    def _candidates(raw):
        """modelId -> ordered lower-cased table keys to try (ModelPricingManager
        .pricingKeyCandidates): strip the provider prefix and date stamp, bridge
        dot/dash minor versions, drop an Antigravity tier suffix, and try both
        word orders around the claude- stem."""
        out = []

        def push(s):
            if not s:
                return
            for form in (s, "anthropic/" + s, "openai/" + s, "google/" + s):
                if form not in out:
                    out.append(form)

        s = raw.lower()
        if "/" in s:
            s = s.rsplit("/", 1)[1]
        push(s)
        no_date = re.sub(r"-\d{6,}$", "", s)
        push(no_date)
        dashed = no_date.replace(".", "-")
        push(dashed)
        dotted = re.sub(r"(\d)-(\d)", r"\1.\2", dashed)
        push(dotted)
        untiered = re.sub(r"-(low|medium|high|thinking)$", "", dotted)
        push(untiered)
        push(untiered + "-preview")

        families = ("opus", "sonnet", "haiku", "fable")
        tokens = dashed.split("-")
        if tokens and tokens[0] == "claude":
            for i, t in enumerate(tokens):
                if t in families:
                    fam = tokens[i]
                    rest = [x for j, x in enumerate(tokens) if j != i and j != 0]
                    if rest:
                        push("-".join(["claude", fam] + rest))
                        push("-".join(["claude"] + rest + [fam]))
                    break
        return out

    def cost(self, model, input_tokens, output_tokens, cache_read, cache_write):
        """Returns (costUSD, priced) - priced False marks an unpriced model so the
        UI can show an explicit estimate rather than a misleading $0.00."""
        r = self.rates(model)
        if r is None:
            return 0.0, False
        cr = r["cacheRead"] if r["cacheRead"] is not None else r["prompt"]
        cw = r["cacheWrite"] if r["cacheWrite"] is not None else r["prompt"]
        total = (input_tokens * r["prompt"] + cache_read * cr
                 + cache_write * cw + output_tokens * r["completion"])
        return total, True


# ----------------------------------------------------------------- totals ----

def new_totals():
    return {"input": 0, "output": 0, "cost": 0.0, "unpriced": False, "pct": False}


def add(t, rec_input, rec_output, cost, priced):
    t["input"] += rec_input
    t["output"] += rec_output
    if priced:
        t["cost"] += cost
    else:
        t["unpriced"] = True


def snapshot_json(snap):
    out = {
        "session": snap["session"],
        "today": snap["today"],
        "week": snap["week"],
        "sessionLimit": snap["sessionLimit"],
        "weekLimit": snap["weekLimit"],
        "plan": snap["plan"],
        "models": snap["models"],
        "newAPIAccounts": snap["newAPIAccounts"],
    }
    return out


def empty_snapshot():
    return {
        "session": new_totals(),
        "today": new_totals(),
        "week": new_totals(),
        "sessionLimit": None,
        "weekLimit": None,
        "plan": None,
        "models": [],
        "newAPIAccounts": [],
    }


# ------------------------------------------------------------ jsonl scan ----

def iter_lines(path):
    try:
        with open(path, "r", errors="ignore") as fh:
            for line in fh:
                line = line.strip()
                if line:
                    yield line
    except OSError:
        return


def parse_iso(ts):
    if not ts:
        return None
    s = ts.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    # Trim sub-second precision pymupdf-free: fromisoformat handles 3/6 digits on
    # 3.11+, but rollouts use variable precision, so normalise it.
    s = re.sub(r"(\.\d{6})\d+", r"\1", s)
    try:
        from datetime import datetime
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=None)
        return dt.timestamp()
    except ValueError:
        return None


def local_day_start(now):
    lt = time.localtime(now)
    return time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))


def recent_files(root, cutoff):
    if not root or not Path(root).is_dir():
        return []
    out = []
    for dirpath, _dirs, files in os.walk(root):
        for name in files:
            if not name.endswith(".jsonl"):
                continue
            p = Path(dirpath) / name
            try:
                if p.stat().st_mtime >= cutoff:
                    out.append(p)
            except OSError:
                pass
    return out


def claude_files():
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
    return root


def codex_root():
    home = os.environ.get("CODEX_HOME", "").strip()
    if home:
        return Path(home) / "sessions"
    return Path.home() / ".codex" / "sessions"


def claude_reason():
    root = claude_files()
    if not root.is_dir():
        return "No ~/.claude/projects - Claude Code not detected"
    if not any(recent_files(root, 0)):
        return "No Claude usage logs found"
    return None


def codex_reason():
    root = codex_root()
    if not root.is_dir():
        return "No ~/.codex/sessions - Codex not detected"
    if not any(recent_files(root, 0)):
        return "No Codex usage logs found"
    return None


def read_claude_plan():
    """oauthAccount.organizationRateLimitTier (or organizationType) from
    ~/.claude.json -> "Max 5x". Plaintext, not a credential."""
    path = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    for candidate in (Path.home() / ".claude.json", path / ".claude.json"):
        try:
            obj = json.loads(candidate.read_text())
        except Exception:
            continue
        account = obj.get("oauthAccount") or {}
        raw = None
        for field in ("organizationRateLimitTier", "organizationType"):
            v = account.get(field)
            if isinstance(v, str) and v.strip():
                raw = v.strip()
                break
        if not raw:
            return None
        s = raw
        for prefix in ("default_claude_", "claude_", "default_"):
            if s.startswith(prefix):
                s = s[len(prefix):]
                break
        parts = []
        for seg in s.split("_"):
            if re.fullmatch(r"\d+x", seg):
                parts.append(seg)
            elif seg:
                parts.append(seg[:1].upper() + seg[1:])
        return " ".join(parts) or None
    return None


def scan_claude(pricing, now):
    root = claude_files()
    week_start = now - WEEK_WINDOW
    session_start = now - SESSION_WINDOW
    day_start = local_day_start(now)
    snap = empty_snapshot()
    per_model = {}
    seen = set()

    for path in recent_files(root, week_start):
        for line in iter_lines(path):
            try:
                obj = json.loads(line)
            except Exception:
                continue
            message = obj.get("message") or {}
            usage = message.get("usage") or obj.get("usage") or {}
            if not isinstance(usage, dict):
                continue
            cache_write = usage.get("cache_creation_input_tokens") or 0
            cache_read = usage.get("cache_read_input_tokens") or 0
            inp = (usage.get("input_tokens") or 0) + cache_write + cache_read
            out = usage.get("output_tokens") or 0
            if inp + out <= 0:
                continue
            ts_raw = obj.get("timestamp") or message.get("timestamp")
            ts = parse_iso(ts_raw)
            if ts is None or ts < week_start:
                continue
            model = message.get("model") or obj.get("model") or "unknown"
            msg_id = message.get("id")
            req_id = obj.get("requestId") or obj.get("request_id")
            if msg_id is not None or req_id is not None:
                key = "%s-%s" % (msg_id or "", req_id or "")
                if key in seen:
                    continue
                seen.add(key)
            uncached = max(0, (usage.get("input_tokens") or 0))
            cost, priced = pricing.cost(model, uncached, out, cache_read, cache_write)
            for t in (snap["week"],):
                add(t, inp, out, cost, priced)
            if ts >= day_start:
                add(snap["today"], inp, out, cost, priced)
            if ts >= session_start:
                add(snap["session"], inp, out, cost, priced)
            mt = per_model.setdefault(model, new_totals())
            add(mt, inp, out, cost, priced)

    snap["models"] = [
        {"model": k, "pool": None, "resetsAt": None, "totals": v}
        for k, v in sorted(per_model.items(), key=lambda kv: -kv[1]["cost"])
    ]
    snap["plan"] = read_claude_plan()
    return snap


def scan_codex(pricing, now):
    root = codex_root()
    week_start = now - WEEK_WINDOW
    session_start = now - SESSION_WINDOW
    day_start = local_day_start(now)
    snap = empty_snapshot()
    per_model = {}
    limits = {}      # newest rate_limits seen (any age)
    limits_ts = 0.0

    for path in recent_files(root, week_start):
        codex_model = None
        for line in iter_lines(path):
            try:
                obj = json.loads(line)
            except Exception:
                continue
            payload = obj.get("payload") or {}
            if obj.get("type") == "turn_context":
                m = payload.get("model")
                if m:
                    codex_model = m
                continue
            if obj.get("type") != "event_msg" or payload.get("type") != "token_count":
                continue
            info = payload.get("info") or {}
            usage = info.get("last_token_usage") or {}
            ts = parse_iso(obj.get("timestamp"))
            if ts is None:
                continue
            # Codex reports input_tokens inclusive of the cached portion; cache
            # writes are separate (JSONLUsageParser.parseCodexTokenCount).
            raw_in = usage.get("input_tokens") or 0
            out = usage.get("output_tokens") or 0
            cache_read = min(raw_in, usage.get("cached_input_tokens") or 0)
            cache_write = usage.get("cache_write_input_tokens") or 0
            inp = raw_in + cache_write
            # Codex records its own rate-limit windows in every token_count, so
            # keep the newest one regardless of the usage window: it stands in for
            # the live wham/usage call Atoll makes. Rejected below when its reset
            # time has already passed, so a stale snapshot cannot mislead.
            rl = payload.get("rate_limits")
            if isinstance(rl, dict) and (rl.get("primary") or rl.get("secondary")) and ts > limits_ts:
                limits = rl
                limits_ts = ts
            if inp + out <= 0 or ts < week_start:
                continue
            model = codex_model or "codex"
            cost, priced = pricing.cost(model, max(0, raw_in - cache_read), out,
                                        cache_read, cache_write)
            add(snap["week"], inp, out, cost, priced)
            if ts >= day_start:
                add(snap["today"], inp, out, cost, priced)
            if ts >= session_start:
                add(snap["session"], inp, out, cost, priced)
            mt = per_model.setdefault(model, new_totals())
            add(mt, inp, out, cost, priced)

    snap["models"] = [
        {"model": k, "pool": None, "resetsAt": None, "totals": v}
        for k, v in sorted(per_model.items(), key=lambda kv: -kv[1]["cost"])
    ]
    snap["sessionLimit"] = _codex_limit(limits.get("primary"), now)
    snap["weekLimit"] = _codex_limit(limits.get("secondary"), now)
    return snap


def _codex_limit(window, now):
    if not isinstance(window, dict):
        return None
    used = window.get("used_percent")
    if used is None:
        return None
    resets = window.get("resets_at")
    if resets and float(resets) <= now:
        return None  # the window already rolled over; the snapshot is stale
    return {"used": float(used), "limit": 100.0,
            "resetsAt": float(resets) if resets else None}


# --------------------------------------------------------------- providers ---

def collect(provider, pricing, now):
    if provider == "claude":
        reason = claude_reason()
        if reason:
            return {"id": provider, "status": "failure", "reason": reason}
        snap = scan_claude(pricing, now)
        result = {"id": provider, "status": "success"}
        result.update(snapshot_json(snap))
        return result
    if provider == "codex":
        reason = codex_reason()
        if reason:
            return {"id": provider, "status": "failure", "reason": reason}
        snap = scan_codex(pricing, now)
        result = {"id": provider, "status": "success"}
        result.update(snapshot_json(snap))
        return result
    if provider == "cursor":
        return {"id": provider, "status": "failure",
                "reason": "Cursor quota unavailable (needs a macOS Cursor session)"}
    if provider == "antigravity":
        return {"id": provider, "status": "failure",
                "reason": "Antigravity not detected on this system"}
    if provider == "newAPI":
        return {"id": provider, "status": "failure",
                "reason": "No New API accounts configured"}
    return {"id": provider, "status": "failure", "reason": "Unknown provider"}


def main(argv):
    providers = []
    for arg in argv[1:]:
        if arg.startswith("--providers="):
            providers = [p for p in arg.split("=", 1)[1].split(",") if p]
        elif not arg.startswith("-"):
            providers.append(arg)
    if not providers:
        providers = ["claude", "codex"]
    pricing = Pricing()
    now = time.time()
    results = {}
    for p in providers:
        try:
            results[p] = collect(p, pricing, now)
        except Exception as exc:  # never fail the whole refresh on one provider
            results[p] = {"id": p, "status": "failure", "reason": str(exc)}
    json.dump({"providers": results, "generated": now}, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
